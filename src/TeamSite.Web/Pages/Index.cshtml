@page
@{
    ViewData["Title"] = "Home";
}
@*
    The home page: https://9082.firstpvrobotics.com/
    Everything below is plain HTML. Change the words between the tags.
    The notes in <!-- --> tell you what goes where; visitors don't see them.
*@

<section class="team-hero">
    <div class="container hero-grid">
        <div>
            <!-- FTC or FRC and your team number. -->
            <span class="eyebrow">FRC Team #9082</span>
            <!-- Your team's name. -->
            <h1>No Limit Robotics</h1>
        </div>
        <!-- Your logo, in wwwroot/images/. Use background: #000000 for logos drawn on black. -->
        <div class="hero-logo" style="background: #ffffff">
            <img src="/images/no-limit-logo.png" alt="No Limit Robotics logo" />
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <h2>About the team</h2>
        <!-- A short summary of your team. One <p> per paragraph. -->
        <div class="prose">
            <p>No Limit Robotics is <em>FIRST</em> Robotics Competition Team #9082 at Pleasant Valley High School. It is the school's only <em>FIRST</em> Robotics Competition team. It is part of Pleasant Valley <em>FIRST</em> Robotics.</p>
        </div>
    </div>
</section>

<section class="section section--alt">
    <div class="container">
        <h2>Follow us</h2>
        <!-- Links to your team's accounts. Copy one <li> line to add another. -->
        <ul class="pills">
            <li><a href="https://www.instagram.com/frc_9082/" rel="noopener" target="_blank">Instagram</a></li>
            <li><a href="https://www.tiktok.com/@@frc.9082.no.limit" rel="noopener" target="_blank">TikTok</a></li>
            <li><a href="https://www.twitter.com/frc9082" rel="noopener" target="_blank">X</a></li>
        </ul>
    </div>
</section>
